# Database Configuration
# Choose database type: "mysql" or "mssql"
DB_TYPE=mysql

# Database Connection String
# For MySQL:
# DATABASE_URL="mysql://sa:123@localhost:3306/test"
# For MSSQL:
# DATABASE_URL="sqlserver://localhost:1433;database=test;user=sa;password=123;encrypt=true;trustServerCertificate=true"

# Admin Credentials (will be seeded into database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123
NEXT_PUBLIC_IGNORE_TS_ERRORS=true

# Locale Configuration
# Supported locales (comma-separated)
#NEXT_PUBLIC_SUPPORTED_LOCALES=tr,en
# Default locale
#NEXT_PUBLIC_DEFAULT_LOCALE=tr
#NEXT_PUBLIC_SITE_URL=
#NEXT_PUBLIC_SITE_DOMAIN=
